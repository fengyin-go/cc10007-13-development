{
  "name": "data-layer-studio-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "repoKind": "frontend-only",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "npm run test:engine && npm run test:service && npm run test:persistence && npm run test:pages && npm run test:dom",
    "test:engine": "esbuild tests/engine.test.mjs --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.cache/engine.test.mjs --log-level=warning && node node_modules/.cache/engine.test.mjs",
    "test:service": "esbuild tests/service.test.mjs --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.cache/service.test.mjs --log-level=warning && node node_modules/.cache/service.test.mjs",
    "test:persistence": "esbuild tests/persistence.test.mjs --bundle --platform=node --format=esm --alias:@=./src --outfile=node_modules/.cache/persistence.test.mjs --log-level=warning && node node_modules/.cache/persistence.test.mjs",
    "test:pages": "node tests/pages.test.mjs",
    "test:dom": "node tests/build-mount.mjs && node tests/dom.test.mjs"
  },
  "dependencies": {
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vitejs/plugin-vue": "^5.0.4",
    "happy-dom": "^15.11.7",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "vue-tsc": "^2.0.7"
  }
}
